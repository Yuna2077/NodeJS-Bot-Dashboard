import { Button, VerticalBox, LineEdit, TextEdit } from "std-widgets.slint";
import { Styles } from "styles.slint";

export component AppWindow inherits Window {
    property <int> count: 0;
    property <string> token: "";

    //default-font-family: "Fedoka One";
    default-font-weight: FontWeight.bold;
    background: Styles.window;

    // Background line edit that allows to use paste functions with buttons.
    le := LineEdit{ width: 0px; height: 0px; }

    GridLayout {
        padding: 25px;
        spacing: 25px;

        Row {
            Text {
                horizontal-alignment: center;

                text: " › Dashboard ‹ ";
                color: Styles.text;
                font-size: 24px;
            }
        }

        Row {
            Rectangle {
                background: Styles.surface;
                border-width: 2px;
                border-color: Styles.accent;
                border-radius: 10px;
                height: 35px;
                clip: true;
                drop-shadow-spread: 1px;
                drop-shadow-blur: 10px;
                drop-shadow-color: Styles.accent;

                Text {
                    width: parent.width;
                    height: parent.height;
                    vertical-alignment: center;
                    horizontal-alignment: center;

                    color: Styles.text;
                    text: "Token: " + token;
                }

                /*
                // attempt 2
                TextEdit {
                    width: parent.width;
                    height: parent.height;
                    horizontal-alignment: center;

                    placeholder-text: "Input token";
                }

                // attempt 1
                LineEdit {
                    width: parent.width;
                    height: parent.height;
                    placeholder-text: "Click to type...";
                }
                */
            }
        }

        Row {
            GridLayout {
                spacing: 25px;

                Rectangle {
                    background: Styles.surface;
                    border-width: 2px;
                    border-color: Styles.accent;
                    border-radius: 10px;
                    height: 35px;
                    clip: true;
                    drop-shadow-spread: 1px;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: Styles.accent;

                    Text {
                        width: parent.width;
                        height: parent.height;
                        vertical-alignment: center;
                        horizontal-alignment: center;

                        text: "Start Bot";
                        color: Styles.text;
                    }

                    TouchArea {
                        clicked => {
                            count = count + 1;
                        }
                    }
                }

                Rectangle {
                    background: Styles.surface;
                    border-width: 2px;
                    border-color: Styles.accent;
                    border-radius: 10px;
                    height: 35px;
                    clip: true;
                    drop-shadow-spread: 1px;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: Styles.accent;

                    Text {
                        width: parent.width;
                        height: parent.height;
                        vertical-alignment: center;
                        horizontal-alignment: center;

                        text: "Paste Token";
                        color: Styles.text;
                    }

                    TouchArea {
                        clicked => {
                            le.paste();
                            token = le.text;
                        }
                    }
                }
            }
        }

        Row {
            Text {
                vertical-alignment: center;
                horizontal-alignment: center;

                text: "© 2026 Yuna2077. Powered by YunaCode";
                color: Styles.text;
            }
        }
    }
}
