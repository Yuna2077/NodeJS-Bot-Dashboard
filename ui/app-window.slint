import { VerticalBox, LineEdit, TextEdit } from "std-widgets.slint";
import { MainFrame, MainButton, LockedButton } from "app-custom-widgets.slint";
import { Styles } from "app-styles.slint";

export component AppWindow inherits Window {
    // properties
    in-out property <bool> bot_online: false;
    in-out property <string> token: "No token set.";
    in-out property <string> ui_status_online: "offline";
    in-out property <int> ui_status_bot_uptime_counter: 0;
    in-out property <string> ui_status_bot_uptime: "00:00:00";

    in-out property <int> ui_status_app_uptime_counter: 0;
    in-out property <string> ui_status_app_uptime: "00:00:00";
    in-out property <string> ui_status_memory: "offline";
    in-out property <string> ui_status_cpu: "offline";
    in-out property <string> ui_header_version: "Loading...";

    in-out property <string> ui_log: "";

    // Callbacks
    callback request_bot_start();
    callback request_bot_stop();
    callback request_bot_restart();
    callback request_bot_put_commands();

    // Style for window + default settings
    default-font-weight: FontWeight.bold;
    height: 1080px / 2.5;
    width: 1920px / 2.5;
    // full-screen: true;
    background: Styles.window;

    // Background line edit that allows to use paste functions with buttons.
    le := LineEdit {
        width: 0px;
        height: 0px;
    }

    FlexboxLayout {
        // Header
        Text {
            width: 100%;
            height: 10%;
            vertical-alignment: center;
            horizontal-alignment: center;

            text: "Simple NodeJS Dashboard ~ V " + ui_header_version;
            color: Styles.text;
        }

        // Main? idk
        HorizontalLayout {
            width: 100%;
            height: 80%;

            //#region MAIN LEFT
            Rectangle {
                width: 50%;
                height: 100%;
                clip: true;

                VerticalLayout {
                    padding: 15px;
                    spacing: 15px;
                    width: 100%;
                    height: 100%;

                    MainFrame {
                        height: 50%;

                        FlexboxLayout {
                            cross-axis-line-alignment: LayoutAlignment.start;
                            alignment: center;
                            padding: 10px;
                            spacing: 10px;

                            // Header
                            Text {
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                height: 10%;
                                width: 100%;

                                text: "~ Bot ~";
                                color: Styles.text;
                            }

                            // Func: Start
                            if !bot_online : MainButton {
                                Text { text: "Start"; color: Styles.text; }
                                TouchArea { clicked => {  request_bot_start(); } }
                            }
                            if bot_online : LockedButton { Text { text: "Start"; color: Styles.text; }}


                            // Func: Stop
                            if bot_online : MainButton {
                                Text { text: "Stop"; color: Styles.text; }
                                TouchArea { clicked => {  request_bot_stop(); } }
                            }
                            if !bot_online : LockedButton { Text { text: "Stop"; color: Styles.text; }}


                            // Func: Restart
                            if bot_online : MainButton {
                                Text { text: "Restart"; color: Styles.text; }
                                TouchArea { clicked => {  request_bot_restart(); } }
                            }
                            if !bot_online : LockedButton { Text { text: "Restart"; color: Styles.text; }}


                            // Func: Put Commands
                            if bot_online : MainButton {
                                Text { text: "Put Commands"; color: Styles.text; }
                                TouchArea { clicked => {  request_bot_put_commands(); } }
                            }
                            if !bot_online : LockedButton { Text { text: "Put Commands"; color: Styles.text; }}
                        }
                    }

                    MainFrame {
                        height: 50%;
                        clip: true;

                        Text {
                            height: 90%; width: 95%;
                            text: ui_log; color: Styles.text;
                        }
                    }
                }
            }
            //#endregion

            //#region MAIN RIGHT
            Rectangle {
                width: 50%;
                height: 100%;

                VerticalLayout {
                    padding: 15px;
                    width: 100%;
                    height: 100%;

                     MainFrame {
                        height: 100%;

                        FlexboxLayout {
                            cross-axis-line-alignment: LayoutAlignment.start;
                            padding: 10px;
                            spacing: 10px;

                            MainButton {
                                width: 100%;
                                height: 13%;

                                Text {
                                    height: 100%;
                                    width: 90%;
                                    vertical-alignment: center;
                                    horizontal-alignment: TextHorizontalAlignment.left;

                                    text: "Status: " + ui_status_online;
                                    color: Styles.text;
                                }
                            }

                            MainButton {
                                width: 100%;
                                height: 13%;

                                Text {
                                    height: 100%;
                                    width: 90%;
                                    vertical-alignment: center;
                                    horizontal-alignment: TextHorizontalAlignment.left;

                                    text: "Bot Uptime: " + ui_status_bot_uptime_counter;
                                    color: Styles.text;
                                }
                            }

                            MainButton {
                                width: 100%;
                                height: 13%;

                                Text {
                                    height: 100%;
                                    width: 90%;
                                    vertical-alignment: center;
                                    horizontal-alignment: TextHorizontalAlignment.left;

                                    text: "App Uptime: " + ui_status_app_uptime;
                                    color: Styles.text;
                                }
                            }

                            MainButton {
                                width: 100%;
                                height: 13%;

                                Text {
                                    height: 100%;
                                    width: 90%;
                                    vertical-alignment: center;
                                    horizontal-alignment: TextHorizontalAlignment.left;

                                    text: "Memory Usage: " + ui_status_memory;
                                    color: Styles.text;
                                }
                            }

                            MainButton {
                                width: 100%;
                                height: 13%;

                                Text {
                                    height: 100%;
                                    width: 90%;
                                    vertical-alignment: center;
                                    horizontal-alignment: TextHorizontalAlignment.left;

                                    text: "Cpu Usage: " + ui_status_cpu;
                                    color: Styles.text;
                                }
                            }
                        }
                    }
                }
            }
            //#endregion
        }

        // Bottom
        Text {
            width: 100%;
            height: 10%;
            vertical-alignment: center;
            horizontal-alignment: center;

            text: "Made with slint\n© 2026 Yuna2077. Powered by YunaCode";
            color: Styles.text;
        }
    }
}
