import { Styles } from "app-styles.slint";

export component MainFrame inherits Rectangle {
    background: Styles.surface;
    border-width: 2px;
    border-color: Styles.accent;
    border-radius: 7px;
}
export component MainButton inherits Rectangle {
    background: Styles.window;
    border-width: 2px;
    border-color: Styles.second_accent;
    border-radius: 7px;
}